---
import { render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import { formatDate, getPosts, type Post } from '../../../lib/posts';
import { LANGS, LOCALES, ui } from '../../../i18n';
import { SITE } from '../../../site.config';

export async function getStaticPaths() {
  const all = await getPosts();
  return LANGS.flatMap((lang) => {
    const posts = all.filter((post) => post.lang === lang);
    return posts.map((post, i) => ({
      params: { lang, slug: post.slug },
      props: {
        post,
        newer: posts[i - 1] as Post | undefined,
        older: posts[i + 1] as Post | undefined,
        translation: all.find((other) => other.lang !== lang && other.key === post.key),
      },
    }));
  });
}

const { post, newer, older, translation } = Astro.props;
const { lang } = post;
const t = ui(lang);
const { Content, headings } = await render(post.entry);
const sections = headings.filter((heading) => heading.depth === 2);
const showToc = sections.length >= 3;
const alternates = { [lang]: post.url, ...(translation && { [translation.lang]: translation.url }) };
const isoDate = post.date.toISOString().slice(0, 10);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.title,
  description: post.description,
  datePublished: post.date.toISOString(),
  dateModified: (post.entry.data.updated ?? post.date).toISOString(),
  inLanguage: LOCALES[lang].html,
  url: new URL(post.url, SITE.url).href,
  mainEntityOfPage: new URL(post.url, SITE.url).href,
  image: new URL('/og.png', SITE.url).href,
  author: { '@type': 'Person', name: SITE.author, url: SITE.url },
  ...(post.topics.length && { articleSection: post.topics.map((topic) => topic.name) }),
};
---

<Base
  lang={lang}
  title={post.title}
  description={post.description}
  alternates={alternates}
  type="article"
  published={post.date}
  jsonLd={jsonLd}
>
  <div class="reading-progress" aria-hidden="true"></div>
  <article class="post">
    <header class="column post-header">
      {
        post.topics.length > 0 && (
          <p class="eyebrow post-topics">
            {post.topics.map((topic) => (
              <a href={`/${lang}/categories/${topic.slug}/`}>{topic.name}</a>
            ))}
          </p>
        )
      }
      <h1 class="post-title">{post.title}</h1>
      {post.summary && <p class="post-dek">{post.summary}</p>}
      <div class="meta post-meta">
        <time datetime={isoDate}>{formatDate(post.date, lang)}</time>
        <span>{t.minRead(post.minutes)}</span>
        {
          translation && (
            <a class="post-translation" href={translation.url} hreflang={LOCALES[translation.lang].html} lang={LOCALES[translation.lang].html}>
              {t.readInOther}
            </a>
          )
        }
      </div>
    </header>

    {
      showToc && (
        <details class="column toc-inline">
          <summary>{t.contents}</summary>
          <ol role="list">
            {sections.map((section) => (
              <li>
                <a href={`#${section.slug}`}>{section.text}</a>
              </li>
            ))}
          </ol>
        </details>
      )
    }

    <div class="post-body">
      {
        showToc && (
          <nav class="toc" aria-label={t.contents}>
            <div class="toc-inner">
              <p class="eyebrow">{t.contents}</p>
              <ol role="list">
                {sections.map((section) => (
                  <li>
                    <a href={`#${section.slug}`} data-toc-link={section.slug}>
                      {section.text}
                    </a>
                  </li>
                ))}
              </ol>
            </div>
          </nav>
        )
      }
      <div class="column prose">
        <Content />
      </div>
    </div>

    <footer class="column post-footer">
      <p class="endnote">
        {t.endnote}{' '}
        <a class="text-link" href={`/${lang}/subscribe/`}>{t.endnoteLink}</a>
      </p>

      <nav class="post-nav" aria-label={t.navMoreEssays}>
        {
          older && (
            <a class="post-nav-link" href={older.url} rel="prev">
              <span class="eyebrow">← {t.previous}</span>
              <span class="post-nav-title">{older.title}</span>
            </a>
          )
        }
        {
          newer && (
            <a class="post-nav-link post-nav-next" href={newer.url} rel="next">
              <span class="eyebrow">{t.next} →</span>
              <span class="post-nav-title">{newer.title}</span>
            </a>
          )
        }
      </nav>
      <a class="arrow-link" href={`/${lang}/posts/`}>{t.backToWriting}</a>
    </footer>
  </article>
</Base>

<script>
  // YouTube embeds load only when clicked (see src/lib/markdown.ts).
  document.querySelectorAll<HTMLAnchorElement>('a[data-youtube]').forEach((link) => {
    link.addEventListener('click', (event) => {
      if (event.metaKey || event.ctrlKey || event.shiftKey) return;
      event.preventDefault();
      const iframe = document.createElement('iframe');
      iframe.src = `https://www.youtube-nocookie.com/embed/${link.dataset.youtube}?autoplay=1&rel=0`;
      iframe.title = 'YouTube video';
      iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
      iframe.allowFullscreen = true;
      link.replaceWith(iframe);
    });
  });

  // Reading progress bar, plus the section being read highlighted in the side table of contents.
  const prose = document.querySelector<HTMLElement>('.prose');
  const progress = document.querySelector<HTMLElement>('.reading-progress');
  const tocLinks = new Map(
    [...document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]')].map((link) => [link.dataset.tocLink!, link]),
  );
  const headings = [...tocLinks.keys()]
    .map((id) => document.getElementById(id))
    .filter((heading): heading is HTMLElement => heading !== null);

  function update() {
    if (prose && progress) {
      const { top, height } = prose.getBoundingClientRect();
      const scrollable = height - window.innerHeight;
      const ratio = scrollable > 0 ? Math.min(Math.max(-top / scrollable, 0), 1) : 1;
      progress.style.transform = `scaleX(${ratio})`;
    }
    if (headings.length) {
      const current = headings.filter((heading) => heading.getBoundingClientRect().top < window.innerHeight * 0.3).at(-1);
      tocLinks.forEach((link, id) => link.toggleAttribute('aria-current', id === current?.id));
    }
  }

  let ticking = false;
  const schedule = () => {
    if (ticking) return;
    ticking = true;
    requestAnimationFrame(() => {
      update();
      ticking = false;
    });
  };
  window.addEventListener('scroll', schedule, { passive: true });
  window.addEventListener('resize', schedule, { passive: true });
  update();
</script>

<style>
  .post-header {
    padding-top: clamp(2.5rem, 7vw, 5rem);
  }

  .post-topics {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
    margin-bottom: 1.25rem;
  }

  .post-topics a {
    color: var(--accent);
  }

  .post-topics a:hover {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .post-title {
    font-size: clamp(2rem, 1.5rem + 2.2vw, 2.875rem);
    line-height: 1.12;
    letter-spacing: -0.02em;
  }

  :global(:lang(zh-CN)) .post-title {
    font-size: clamp(1.875rem, 1.4rem + 2vw, 2.625rem);
    line-height: 1.3;
    letter-spacing: 0.01em;
  }

  /* Like a printed headline, a long title may run wider than the text below it. */
  @media (min-width: 64rem) {
    .post-title {
      width: 48rem;
    }
  }

  .post-dek {
    margin-top: 1.25rem;
    font-family: var(--font-body);
    font-size: 1.3125rem;
    line-height: 1.5;
    color: var(--text-2);
  }

  :global(:lang(zh-CN)) .post-dek {
    font-size: 1.125rem;
    line-height: 1.75;
  }

  .post-meta {
    margin-top: 1.75rem;
    padding-bottom: 2.25rem;
    border-bottom: 1px solid var(--rule);
  }

  .post-translation {
    color: var(--accent);
  }

  .post-translation:hover {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .post-body {
    position: relative;
    margin-top: 2.5rem;
  }

  /* Table of contents: a disclosure above the text on narrow screens, a sticky margin column on wide ones. */
  .toc-inline {
    margin-top: 1.5rem;
    font-size: 0.9375rem;
  }

  .toc-inline summary {
    width: fit-content;
    cursor: pointer;
    color: var(--text-2);
  }

  .toc-inline ol,
  .toc ol {
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: section;
  }

  .toc-inline ol {
    margin-top: 0.75rem;
    padding-left: 1rem;
    border-left: 1px solid var(--rule);
  }

  .toc-inline li + li,
  .toc li + li {
    margin-top: 0.5rem;
  }

  .toc-inline a,
  .toc a {
    color: var(--text-2);
    transition: color 0.15s var(--ease);
  }

  .toc-inline a:hover,
  .toc a:hover,
  .toc a[aria-current] {
    color: var(--text);
  }

  .toc {
    display: none;
  }

  @media (min-width: 76rem) {
    .toc-inline {
      display: none;
    }

    .toc {
      display: block;
      position: absolute;
      top: 0.4rem;
      bottom: 0;
      left: calc(50% + var(--measure) / 2 + 4rem);
      width: 13rem;
    }

    .toc-inner {
      position: sticky;
      top: 2rem;
    }

    .toc ol {
      margin-top: 1rem;
      border-left: 1px solid var(--rule);
    }

    .toc a {
      display: block;
      margin-left: -1px;
      padding-left: 1rem;
      border-left: 1px solid transparent;
      font-size: 0.8125rem;
      line-height: 1.45;
    }

    .toc a[aria-current] {
      border-left-color: var(--accent);
    }
  }

  .post-footer {
    margin-top: 4rem;
  }

  .endnote {
    padding-top: 2rem;
    border-top: 1px solid var(--rule);
    color: var(--text-2);
  }

  .post-nav {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    margin-block: 2.5rem;
  }

  .post-nav-link {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1.125rem 1.25rem;
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    transition: border-color 0.15s var(--ease);
  }

  .post-nav-link:hover {
    border-color: var(--rule-strong);
  }

  .post-nav-next {
    grid-column: 2;
    text-align: right;
  }

  .post-nav-title {
    font-family: var(--font-display);
    font-size: 1.0625rem;
    font-weight: 600;
    line-height: 1.35;
  }

  .post-nav-link:hover .post-nav-title {
    color: var(--accent);
  }

  .reading-progress {
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    height: 2px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: 0 50%;
    pointer-events: none;
  }

  @media (max-width: 40rem) {
    .post-nav {
      grid-template-columns: 1fr;
    }

    .post-nav-next {
      grid-column: auto;
    }
  }
</style>
