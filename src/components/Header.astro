---
import BrandMark from './BrandMark.astro';
import { LOCALES, otherLang, ui, type Lang } from '../i18n';

interface Props {
  lang: Lang;
  /** Where the language switch leads: the translated page, or the other home page. */
  switchHref: string;
}

const { lang, switchHref } = Astro.props;
const t = ui(lang);
const target = otherLang(lang);
const path = Astro.url.pathname;

const links = [
  { href: `/${lang}/posts/`, label: t.navWriting },
  { href: `/${lang}/about/`, label: t.navAbout },
  { href: `/${lang}/subscribe/`, label: t.navSubscribe },
];
const isCurrent = (href: string) =>
  path === href || (href.endsWith('/posts/') && (path.startsWith(href) || path.startsWith(`/${lang}/categories/`)));
---

<header class="site-header">
  <div class="page header-inner">
    <a class="brand" href={`/${lang}/`}>
      <BrandMark />
      <span class="brand-name">Hance Zhang</span>
    </a>

    <nav class="site-nav" aria-label={t.navMain}>
      {
        links.map(({ href, label }) => (
          <a href={href} aria-current={isCurrent(href) ? 'page' : undefined}>
            {label}
          </a>
        ))
      }
    </nav>

    <div class="header-tools">
      <a class="lang-switch" href={switchHref} hreflang={LOCALES[target].html} lang={LOCALES[target].html} data-lang={target}>
        {LOCALES[target].name}
      </a>
      <button class="theme-toggle" type="button" aria-label={t.toggleTheme} data-theme-toggle>
        <svg class="icon-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M20.5 14.1A8.5 8.5 0 0 1 9.9 3.5a8.5 8.5 0 1 0 10.6 10.6z"></path>
        </svg>
        <svg class="icon-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2.5v2M12 19.5v2M4.6 4.6 6 6M18 18l1.4 1.4M2.5 12h2M19.5 12h2M4.6 19.4 6 18M18 6l1.4-1.4"></path>
        </svg>
      </button>
    </div>
  </div>
</header>

<script>
  const root = document.documentElement;

  document.querySelector('[data-theme-toggle]')?.addEventListener('click', () => {
    const current = root.dataset.theme ?? (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
    const next = current === 'dark' ? 'light' : 'dark';
    root.dataset.theme = next;
    try {
      localStorage.setItem('theme', next);
    } catch {}
  });

  // Remember an explicit language choice so the bare domain opens in it next time.
  document.querySelectorAll<HTMLAnchorElement>('[data-lang]').forEach((link) =>
    link.addEventListener('click', () => {
      try {
        localStorage.setItem('lang', link.dataset.lang ?? '');
      } catch {}
    }),
  );
</script>

<style>
  .site-header {
    padding-block: 1.25rem;
  }

  .header-inner {
    display: grid;
    grid-template-columns: 1fr auto auto;
    grid-template-areas: 'brand nav tools';
    align-items: center;
    gap: 0.75rem 2rem;
  }

  .brand {
    grid-area: brand;
    justify-self: start;
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
  }

  .brand-name {
    font-family: var(--font-serif);
    font-size: 1.1875rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .site-nav {
    grid-area: nav;
    display: flex;
    gap: 1.75rem;
    font-size: 0.9375rem;
  }

  .site-nav a {
    position: relative;
    padding-block: 0.25rem;
    color: var(--text-2);
    transition: color 0.15s var(--ease);
  }

  .site-nav a:hover,
  .site-nav a[aria-current='page'] {
    color: var(--text);
  }

  .site-nav a[aria-current='page']::after {
    content: '';
    position: absolute;
    inset: auto 0 -0.125rem;
    height: 2px;
    border-radius: 2px;
    background: var(--accent);
  }

  .header-tools {
    grid-area: tools;
    display: flex;
    align-items: center;
    gap: 0.375rem;
  }

  .lang-switch,
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 2.125rem;
    border: 1px solid var(--rule);
    border-radius: 999px;
    background: transparent;
    color: var(--text-2);
    transition: color 0.15s var(--ease), border-color 0.15s var(--ease);
  }

  .lang-switch {
    padding-inline: 0.75rem;
    font-size: 0.8125rem;
    font-weight: 500;
  }

  .theme-toggle {
    width: 2.125rem;
    padding: 0;
    cursor: pointer;
  }

  .lang-switch:hover,
  .theme-toggle:hover {
    color: var(--text);
    border-color: var(--rule-strong);
  }

  .icon-sun {
    display: none;
  }

  :global([data-theme='dark']) .icon-sun {
    display: block;
  }

  :global([data-theme='dark']) .icon-moon {
    display: none;
  }

  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .icon-sun {
      display: block;
    }

    :global(:root:not([data-theme='light'])) .icon-moon {
      display: none;
    }
  }

  @media (max-width: 40rem) {
    .site-header {
      padding-block: 1rem 0.5rem;
    }

    .header-inner {
      grid-template-columns: 1fr auto;
      grid-template-areas:
        'brand tools'
        'nav nav';
    }

    .site-nav {
      gap: 1.5rem;
    }
  }
</style>
